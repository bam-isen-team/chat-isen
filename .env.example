# Copy this file to .env and adjust the values:
#     cp .env.example .env
#
# .env is gitignored: never put a real secret in here,
# development values only.

# --- Database (docker compose db service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- Backend (see ADR-001) ---
# Database URL for the backend:
#   - from a docker-compose container, the host is the service name: db
#   - from the host machine (dev tools), use localhost
DATABASE_URL=postgres://app:change_me@localhost:5432/app

# JWT signing secret: at least 64 random bytes (HS256, see ADR-001).
# Generate one with:
#     openssl rand -base64 64
JWT_SECRET=change_me

BACKEND_BIND_ADDR=0.0.0.0:3000
