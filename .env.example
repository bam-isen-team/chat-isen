# Copy this file to .env and adjust the values:
#     cp .env.example .env
#
# .env is gitignored: never put a real secret in here,
# development values only.

POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app
POSTGRES_PORT=5432

# Database URL for the backend (see ADR-001):
#   - from a docker-compose container, the host is the service name: db
#   - from the host machine (dev tools), use localhost
# DATABASE_URL=postgres://app:change-me@db:5432/app
